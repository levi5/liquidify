{
  "name": "liquidify-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Site estático de documentação do Liquidify (Vite + React), publicado no GitHub Pages",
  "type": "module",
  "scripts": {
    "catalog": "node scripts/generate-example-catalog.mjs",
    "predev": "pnpm run catalog",
    "dev": "vite",
    "prebuild": "pnpm run catalog",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.9.2",
    "vite": "^6.3.5"
  }
}
