{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2021", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["lib/core/*"],
      "@application/*": ["lib/application/*"],
      "@adapters/*": ["lib/infra/adapters/*"],
      "@presentation/*": ["lib/presentation/*"],
      "@main/*": ["lib/main/*"],
      "@shared/*": ["lib/shared/*"],
      "@liquidify-types/*": ["lib/types/*"],
      "@react-runtime/*": ["resources/react/*"]
    }
  }
}
