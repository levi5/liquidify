{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "paths": {
      "liquidify": [
        "lib/index.ts"
      ],
      "liquidex": [
        "lib/types/liquidex.ts"
      ],
      "@core/*": [
        "lib/core/*"
      ],
      "@application/*": [
        "lib/application/*"
      ],
      "@adapters/*": [
        "lib/infra/adapters/*"
      ],
      "@presentation/*": [
        "lib/presentation/*"
      ],
      "@main/*": [
        "lib/main/*"
      ],
      "@types/*": [
        "lib/types/*"
      ]
    }
  },
  "include": ["lib/**/*"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}