{
  "name": "liquidify",
  "version": "1.0.0-alpha.5",
  "description": "TSX to Shopify Liquid compiler with Babel & esbuild",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "default": "./dist/types/runtime.js"
    }
  },
  "files": [
    "dist",
    "resources"
  ],
  "bin": {
    "liquidify": "dist/presentation/cli/index.js",
    "liquidify:watch": "dist/presentation/cli/watch.js",
    "liquidx": "dist/presentation/cli/index.js",
    "liquidx:watch": "dist/presentation/cli/watch.js"
  },
  "scripts": {
    "format": "biome format lib  --write",
    "lint": "biome check lib  --apply",
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.lib.json",
    "build:example": "npm --prefix example run build",
    "dev:example": "npm --prefix example run dev",
    "typecheck:example": "npm --prefix example run typecheck",
    "dev": "tsc --watch",
    "start": "node dist/presentation/cli/index.js",
    "liquidify": "tsx --tsconfig tsconfig.runtime.json lib/presentation/cli/index.ts",
    "liquidify:watch": "tsx lib/presentation/cli/index.ts --watch",
    "liquidx": "tsx --tsconfig tsconfig.runtime.json lib/presentation/cli/index.ts",
    "liquidx:watch": "tsx lib/presentation/cli/index.ts --watch"
  },
  "keywords": [
    "shopify",
    "liquid",
    "tsx",
    "babel",
    "esbuild",
    "compiler"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/generator": "^7.23.6",
    "@babel/parser": "^7.23.6",
    "@babel/traverse": "^7.23.6",
    "@babel/types": "^7.23.6",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "classnames": "^2.5.1",
    "esbuild": "0.27.3",
    "funcio": "^0.0.29",
    "glob": "^10.3.10",
    "kleur": "^4.1.5",
    "ora": "^5.4.1",
    "preact": "^10.28.4",
    "react-icons": "^5.6.0",
    "swiper": "^12.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@biomejs/biome": "^2.4.4",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.5",
    "@types/node": "^20.10.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
