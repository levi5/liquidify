{
  "name": "liquidify",
  "version": "1.1.0-alpha.4",
  "description": "TSX to Shopify Liquid compiler with Babel & esbuild",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "default": "./dist/types/runtime.js"
    }
  },
  "files": [
    "dist",
    "resources",
    "docs"
  ],
  "bin": {
    "liquidify": "dist/presentation/cli/index.js",
    "liquidify-watch": "dist/presentation/cli/watch.js",
    "liquidx": "dist/presentation/cli/index.js",
    "liquidx-watch": "dist/presentation/cli/watch.js"
  },
  "scripts": {
    "format": "biome format lib tests --write",
    "lint": "biome check lib tests",
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.react.json && tsc -p resources/templates/theme/tsconfig.json --noEmit",
    "typecheck:react": "tsc -p tsconfig.react.json",
    "typecheck:theme": "tsc -p tsconfig.lib.json && tsc -p resources/templates/theme/tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.lib.json",
    "test": "node --test tests/*.test.mjs tests/runtime/*.test.cjs",
    "dev": "tsc -p tsconfig.lib.json --watch",
    "start": "node dist/presentation/cli/index.js",
    "liquidify": "tsx --tsconfig tsconfig.runtime.json lib/presentation/cli/index.ts",
    "liquidify:watch": "tsx lib/presentation/cli/index.ts --watch",
    "liquidx": "tsx --tsconfig tsconfig.runtime.json lib/presentation/cli/index.ts",
    "liquidx:watch": "tsx lib/presentation/cli/index.ts --watch",
    "test:runtime": "npm run build && node --test \"tests/runtime/*.test.cjs\"",
    "test:example:browser": "npm run build && node tests/react-example-browser.cjs",
    "test:fast": "npm run build && node --test tests/cli-args.test.mjs tests/string-utils.test.mjs tests/liquid-content.test.mjs tests/expression-cache.test.mjs tests/config-loader.test.mjs"
  },
  "keywords": [
    "shopify",
    "liquid",
    "tsx",
    "babel",
    "esbuild",
    "compiler"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "chokidar": "^4.0.3",
    "classnames": "^2.5.1",
    "esbuild": "^0.28.2",
    "funcio": "^0.0.32",
    "glob": "^13.0.6",
    "kleur": "^4.1.5",
    "ora": "^5.4.1",
    "react-icons": "^5.7.0",
    "swiper": "^14.3.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.2"
  },
  "peerDependencies": {
    "preact": "^10.29.8"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.5.14",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.13.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
