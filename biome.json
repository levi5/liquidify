{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"formatter": {
		"enabled": true,
		"lineWidth": 140,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineEnding": "lf"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"useKeyWithClickEvents": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "off"
			},
			"complexity": {
				"useOptionalChain": "off",
				"noForEach": "off"
			},
			"style":{
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noMisleadingCharacterClass": "off",
				"noConfusingVoidType": "off",
				"noExplicitAny": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"semicolons": "asNeeded",
			"quoteStyle": "single",
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"jsxQuoteStyle": "single"
		}
	},
	"files": {
		"includes": [
			"lib/**",
			"tests/**",
			"!lib/docs/**"
		]
	},
	"overrides": [
		{
			"includes": [
				"tests/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noTemplateCurlyInString": "off"
					}
				}
			}
		},
		{
			"includes": [
				"tests/fixtures/**"
			],
			"linter": {
				"enabled": false
			}
		}
	]
}