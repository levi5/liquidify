    <a href="/" style="font-size: 1.25rem; font-weight: 700; color: #0f172a; text-decoration: none; ">
      {{ shop.name }}
    </a>
  </div>
  <nav style="display: flex; align-items: center; gap: 1.5rem; ">
    <a href="/" style="font-size: 0.95rem; color: #475569; text-decoration: none; font-weight: 500; ">
      Home
    </a>
  </nav>
</header>

