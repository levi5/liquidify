<section style="padding: 5rem 1.5rem 3rem; text-align: center; background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%); border-bottom: 1px solid #e2e8f0; ">
  <div class="container">
    {% render 'badge', text: "🚀 Liquidify + Shopify Starter" %}
    <h1 style="font-size: 2.5rem; font-weight: 800; color: #0f172a; margin-bottom: 1rem; ">
      {{ section.settings.heading }}
    </h1>
    <p style="font-size: 1.2rem; color: #64748b; max-width: 640px; margin: 0 auto 2.5rem; ">
      {{ section.settings.subheading }}
    </p>
    <div id="counter-root"></div>
  </div>
</section>

{%- unless script_counter_loaded -%}
  <script src="{{ 'counter.js' | asset_url }}" defer></script>
  {%- assign script_counter_loaded = true -%}
{%- endunless -%}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Shopify Themes with TSX"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Write React/TSX components and let Liquidify compile them to clean Shopify Liquid."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
