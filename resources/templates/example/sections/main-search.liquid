<section class="search-page container section-space">
  <div class="page-heading">
    <p class="eyebrow">
      FIND WHAT MATCHES YOU
    </p>
    <h1>
      Great finds.
    </h1>
    <form action="{{ routes.search_url | escape }}" method="get" role="search" class="page-search">
      <input type="hidden" name="type" value="product" />
      <label class="visually-hidden" for="PageSearch">
        Search products
      </label>
      <input type="search" id="PageSearch" name="q" value="{{ search.terms | escape }}" placeholder="What are you looking for?" required />
      <button class="button button-dark" type="submit">
        Search ↗
      </button>
    </form>
  </div>
  <p class="catalog-meta">
    {{ search.results_count | escape }} results for “{{ search.terms | escape }}”
  </p>
  {% paginate search.results by section.settings.products_per_page %}
{% if search.results.size > 0 %}
  <div class="product-grid">
    {% for item in search.results %}{% if item.object_type == "product" %}
{% render 'product-card', item: item %}
{% else %}
    <article class="search-text-result">
      <a href="{{ item.url | escape }}">
        <h2>
          {{ item.title | escape }}
        </h2>
        <span>
          Learn more ↗
        </span>
      </a>
    </article>
    {% endif %}{% endfor %}
  </div>
  {% else %}
  <div class="empty-state">
    <span class="empty-spark">
      ✳
    </span>
    <h2>
      Let's try another way?
    </h2>
    <p>
      Try another term or discover all pieces in the store.
    </p>
    <a class="button button-dark" href="{{ routes.all_products_collection_url | escape }}">
      Explore the store ↗
    </a>
  </div>
  {% endif %}{% render 'pagination', pager: paginate %}
{% endpaginate %}
</section>

{% schema %}
{
  "name": "Search Results",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Results per page",
      "min": 6,
      "max": 36,
      "step": 6,
      "default": 12
    }
  ]
}
{% endschema %}

{% stylesheet %}
.search-page {
  min-height: 50vh;
}

.page-search {
  display: flex;
  gap: 12px;
  max-width: 580px;
  margin-top: 25px;
}

.page-search input {
  flex: 1;
}

.search-text-result {
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: 8px;
}

.search-text-result h2 {
  font-size: 18px;
  margin-bottom: 12px;
}

{% endstylesheet %}