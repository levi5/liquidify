<section class="values-strip container" aria-label="Shop with confidence">
  <div class="value-item">
    {% render 'theme-icon', name: 'truck' %}
    <div>
      <h3>
        Your way, to you
      </h3>
      <p>
        Check delivery options at checkout
      </p>
    </div>
  </div>
  <div class="value-item">
    {% render 'theme-icon', name: 'shield' %}
    <div>
      <h3>
        Secure purchase
      </h3>
      <p>
        Your data protected at every step
      </p>
    </div>
  </div>
  <div class="value-item">
    {% render 'theme-icon', name: 'return' %}
    <div>
      <h3>
        Count on us
      </h3>
      <p>
        Support to help with your choice
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Store Benefits",
  "settings": [],
  "presets": [
    {
      "name": "Store Benefits"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.values-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding-block: 28px;
  border-bottom: 1px solid var(--line);
}

.value-item {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 15px;
  border-right: 1px solid var(--line);
}

.value-item:last-child {
  border: 0;
}

.value-item > svg {
  width: 25px;
  height: 25px;
  flex-shrink: 0;
}

.value-item h3 {
  font-size: 11px;
  font-weight: 500;
  margin-bottom: 5px;
}

.value-item p {
  font-size: 9px;
  color: var(--muted);
}

@media (max-width: 990px) {
  .values-strip {
    grid-template-columns: 1fr;
    gap: 18px;
    padding-block: 22px;
  }
  .value-item {
    border-right: 0;
    justify-content: flex-start;
  }
}

{% endstylesheet %}