<section class="product-detail container section-space">
  <nav class="breadcrumbs" aria-label="Navegação estrutural">
    <a href="{{ routes.root_url | escape }}">
      Início
    </a>
    <span>
      /
    </span>
    <a href="{{ routes.all_products_collection_url | escape }}">
      Loja
    </a>
    <span>
      /
    </span>
    <span>
      {{ product.title | escape }}
    </span>
  </nav>
  <div class="product-detail-grid">
    <div class="product-gallery">
      {% if product.featured_image %}
      <a class="main-product-image" href="{{ product.featured_image | image_url: width: 2000 | escape }}" target="_blank" rel="noopener">
        <img id="ProductMainImage" src="{{ product.featured_image | image_url: width: 1200 | escape }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1000" height="1200" fetchpriority="high" />
      </a>
      {% else %}
      <div class="product-placeholder">
        ✳
      </div>
      {% endif %}{% if product.images.size > 1 %}
      <div class="product-thumbnails">
        {% for photo in product.images %}
        <a href="{{ photo | image_url: width: 2000 | escape }}" data-product-thumbnail="{{ photo | image_url: width: 1200 | escape }}">
          <img src="{{ photo | image_url: width: 200 | escape }}" alt="{{ photo.alt | default: product.title | escape }}" width="120" height="144" loading="lazy" />
        </a>
        {% endfor %}
      </div>
      {% endif %}{% for media in product.media %}{% if media.media_type != "image" %}
      <div class="product-media">
        {{ media.media_tag | escape }}
      </div>
      {% endif %}{% endfor %}
    </div>
    <div class="product-detail-copy">
      <p class="eyebrow">
        {{ product.vendor | escape }}
      </p>
      <h1>
        {{ product.title | escape }}
      </h1>
      <p class="product-intro">
        Estilo para acompanhar o seu ritmo. Escolha sua combinação.
      </p>
      <div class="island-bridge" data-liquid-store="{{ product | json | escape }}" data-liquid-selected="{{ product.selected_or_first_available_variant.id | json | escape }}">
        <react-island data-hydrate="eager" style="display: flex;" component="ProductPurchase">
          <form action="{{ routes.cart_add_url | escape }}" method="post" class="purchase-form">
            <p class="detail-price">
              {{ product.price | money | escape }}
            </p>
            <label for="FallbackVariant">
              Escolha uma opção
            </label>
            <select id="FallbackVariant" name="id">
              {% for variant in product.variants %}
              <option value="{{ variant.id | escape }}"{% if variant.available %}{% else %} disabled{% endif %}{% if variant.id == product.selected_or_first_available_variant.id %} selected{% endif %}>
                {{ variant.title | escape }} — {{ variant.price | money | escape }}
              </option>
              {% endfor %}
            </select>
            <label for="FallbackQuantity">
              Quantidade
            </label>
            <input id="FallbackQuantity" name="quantity" type="number" min="1" value="1" />
            <fieldset{% if product.requires_selling_plan == true %} disabled{% endif %} style="border: 0; margin: 0; padding: 0; ">
              <button class="button button-dark product-add-button" style="width: 100%; max-width: 320px; " type="submit"{% if product.available %}{% else %} disabled{% endif %}>
                Adicionar à sacola ↗
              </button>
            </fieldset>
          </form>
          </react-island>
          {% if product.requires_selling_plan %}
          <noscript>
            Este produto exige um plano de assinatura. Entre em contato com a loja para escolher seu plano.
          </noscript>
          {% endif %}
        </div>
        <div class="purchase-note">
          <span aria-hidden="true">
            ↗
          </span>
          <span>
            Frete calculado no checkout.
            <br />
            Seus dados protegidos em cada etapa.
          </span>
        </div>
        <details class="product-accordion" open>
          <summary>
            Sobre a peça
            <span>
              +
            </span>
          </summary>
          <div class="rich-text">
            {{ product.description | escape }}
          </div>
        </details>
        <details class="product-accordion">
          <summary>
            Entrega e devolução
            <span>
              +
            </span>
          </summary>
          <div class="rich-text">
            <p>
              Informe seu endereço no checkout para consultar os prazos e as opções de entrega disponíveis.
            </p>
            {% if shop.shipping_policy %}
            <a href="{{ shop.shipping_policy.url | escape }}">
              Política de envio ↗
            </a>
            {% endif %}{% if shop.refund_policy %}
            <a href="{{ shop.refund_policy.url | escape }}">
              Política de devolução ↗
            </a>
            {% endif %}
          </div>
        </details>
      </div>
    </div>
    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  </section>

{%- unless script_product_purchase_loaded -%}
  <script src="{{ 'product-purchase.js' | asset_url }}" defer></script>
  {%- assign script_product_purchase_loaded = true -%}
{%- endunless -%}

{% schema %}
{
  "name": "Detalhes do produto",
  "settings": []
}
{% endschema %}

{% stylesheet %}
.product-detail {
  padding-top: 35px;
}

.product-detail-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 85px;
}

.main-product-image {
  display: block;
  aspect-ratio: 5/6;
  background: var(--surface);
  border-radius: 10px;
  overflow: hidden;
}

.main-product-image img {
  height: 100%;
  width: 100%;
  object-fit: cover;
}

.product-thumbnails {
  display: flex;
  gap: 10px;
  margin-top: 14px;
  overflow: auto;
}

.product-thumbnails a {
  width: 80px;
  flex-shrink: 0;
  border: 1px solid transparent;
  border-radius: 5px;
  overflow: hidden;
}

.product-thumbnails a:hover {
  border-color: var(--ink);
}

.product-thumbnails img {
  aspect-ratio: 5/6;
  object-fit: cover;
}

.product-media {
  margin-top: 20px;
}

.product-media video,
.product-media iframe,
.product-media model-viewer {
  width: 100%;
  max-height: 650px;
}

.product-detail-copy {
  padding-top: 20px;
}

.product-detail-copy h1 {
  font-size: 43px;
  letter-spacing: -1.7px;
  margin: 17px 0;
}

.product-intro {
  color: var(--muted);
  font-size: 12px;
  margin-bottom: 26px;
}

.detail-price {
  display: flex;
  align-items: center;
  gap: 15px;
  font-size: 25px;
  margin-bottom: 26px;
  line-height: 1.2;
}

.detail-price strong {
  font-weight: 550;
}

.variant-group {
  margin-bottom: 23px;
}

.variant-group legend,
.purchase-form > label {
  font-size: 11px;
  margin-bottom: 10px;
}

.variant-group legend strong {
  font-weight: 500;
}

.variant-options {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.variant-options button {
  padding: 10px 15px;
  font-size: 11px;
  border: 1px solid var(--line);
  background: transparent;
  border-radius: 4px;
}

.variant-options button[aria-pressed='true'] {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

.purchase-actions {
  display: flex;
  gap: 12px;
}

.purchase-actions > .button {
  flex: 1;
  justify-content: space-between;
  padding-inline: 18px;
  gap: 15px;
}

.purchase-note {
  display: flex;
  gap: 13px;
  font-size: 10px;
  line-height: 1.9;
  padding: 23px 0 29px;
  color: var(--muted);
}

.purchase-note > span:first-child {
  font-size: 21px;
  color: var(--ink);
}

.product-accordion {
  border-top: 1px solid var(--line);
}

.product-accordion:last-child {
  border-bottom: 1px solid var(--line);
}

.product-accordion summary {
  display: flex;
  justify-content: space-between;
  padding-block: 18px;
  font-size: 12px;
}

.product-accordion[open] summary > span {
  transform: rotate(45deg);
}

.product-accordion .rich-text {
  padding-bottom: 24px;
  font-size: 12px;
  color: var(--muted);
}

@media (max-width: 900px) {
  .product-detail-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}

{% endstylesheet %}