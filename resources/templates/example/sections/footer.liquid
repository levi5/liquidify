<footer class="site-footer">
  <div class="newsletter container">
    <div>
      <p class="eyebrow">
        VAMOS FICAR MAIS PERTO?
      </p>
      <h2>
        Entre para a nossa lista.
        <br />
        Fique por dentro do próximo drop.
      </h2>
    </div>
    <div class="newsletter-form">
      {% form 'customer', id: 'FooterNewsletter' %}
      <input type="hidden" name="contact[tags]" value="newsletter" />
      <label for="NewsletterEmail">
        Seu melhor e-mail
      </label>
      <div class="email-field">
        <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="voce@email.com" autocomplete="email" required />
        <button type="submit" aria-label="Inscrever-se na newsletter">
          ↗
        </button>
      </div>
      {% if form["posted_successfully"] %}
      <p role="status">
        Você está na lista. Até o próximo encontro!
      </p>
      {% endif %}{% if form.errors %}
      <div role="alert">
        {{ form.errors | default_errors }}
      </div>
      {% endif %}
      <p class="newsletter-note">
        Novidades, lançamentos e inspiração. Cancele quando quiser.
      </p>
      {% endform %}
    </div>
  </div>
  <div class="footer-main container">
    <div class="footer-brand">
      <a class="wordmark" href="{{ routes.root_url | escape }}">
        {{ settings.brand_name | default: shop.name | escape }}
      </a>
      <p>
        Seu estilo. Suas regras.
        <br />
        Isso é Liquidify.
      </p>
    </div>
    <div>
      <h3>
        Explore
      </h3>
      <a href="{{ routes.all_products_collection_url | escape }}">
        Todos os produtos
      </a>
      <a href="{{ routes.collections_url | escape }}">
        Nossas coleções
      </a>
      <a href="{{ routes.root_url | escape }}#essencia">
        Nossa essência
      </a>
    </div>
    <div>
      <h3>
        Podemos ajudar?
      </h3>
      <a href="{{ routes.account_url | escape }}">
        Minha conta
      </a>
      <a href="{{ routes.cart_url | escape }}">
        Minha sacola
      </a>
      <a href="mailto:{{ shop.email | escape }}">
        Fale com a gente
      </a>
    </div>
    <div>
      <h3>
        Informações
      </h3>
      {% for link in section.settings.menu.links %}
      <a href="{{ link.url | escape }}">
        {{ link.title | escape }}
      </a>
      {% endfor %}{% for policy in shop.policies %}
      <a href="{{ policy.url | escape }}">
        {{ policy.title | escape }}
      </a>
      {% endfor %}
    </div>
  </div>
  <div class="footer-bottom container">
    <span>
      ©{{ "now" | date: "%Y" }} {{ settings.brand_name | default: shop.name | escape }}. Todos os direitos reservados.
    </span>
    <span>
      LIQUIDIFY / EVERYDAY CULTURE
      <span aria-hidden="true">
        ↗
      </span>
    </span>
    <span>
      Pagamento seguro · Shopify
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé e newsletter",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu de informações",
      "default": "footer"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.site-footer {
  background: #f4f4f4;
  border-top: 1px solid var(--line);
}

.newsletter {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 80px;
  padding-block: 50px;
  border-bottom: 1px solid #ddd;
  align-items: center;
}

.newsletter h2 {
  font-size: 29px;
  letter-spacing: -0.8px;
  line-height: 1.25;
  margin-top: 13px;
}

.newsletter .eyebrow {
  font-size: 8px;
  color: #666;
}

.newsletter-form label {
  font-size: 10px;
  margin-bottom: 8px;
}

.email-field {
  display: flex;
  background: white;
  border: 1px solid #ddd;
  border-radius: 5px;
  overflow: hidden;
}

.email-field input {
  flex: 1;
  border: 0;
  min-width: 0;
  font-size: 12px;
  padding: 15px;
}

.email-field button {
  background: #171717;
  color: white;
  font-size: 23px;
  width: 52px;
}

.newsletter-note {
  font-size: 9px;
  color: #777;
  margin-top: 10px;
}

.footer-main {
  display: grid;
  grid-template-columns: 1.7fr 1fr 1fr 1fr;
  gap: 35px;
  padding-block: 45px;
}

.footer-brand .wordmark {
  font-size: 44px;
}

.footer-brand p {
  font-size: 11px;
  color: #666;
  margin-top: 20px;
  line-height: 1.8;
}

.footer-main h3 {
  font-size: 11px;
  font-weight: 600;
  margin-bottom: 20px;
}

.footer-main > div:not(.footer-brand) > a {
  display: block;
  font-size: 11px;
  color: #666;
  margin-block: 9px;
}

.footer-main a:hover {
  color: #111;
}

.footer-bottom {
  padding-block: 20px;
  border-top: 1px solid #ddd;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  color: #777;
  font-size: 8px;
}

.footer-bottom > span:nth-child(2) {
  font-size: 7px;
  letter-spacing: 1px;
}

.footer-bottom > span:nth-child(2) > span {
  margin-left: 5px;
}

@media (max-width: 900px) {
  .newsletter {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .footer-main {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 680px) {
  .footer-main {
    grid-template-columns: 1fr;
    gap: 25px;
  }
  .footer-bottom {
    flex-direction: column;
    gap: 10px;
  }
}

{% endstylesheet %}