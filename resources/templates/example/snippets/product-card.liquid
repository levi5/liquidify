<article class="product-card">
  <a class="product-image-link" href="{{ item.url | escape }}" aria-label="{{ item.title | escape }}">
    {% if item.featured_image %}
    <img class="product-primary-image" src="{{ item.featured_image | image_url: width: 700 | escape }}" alt="{{ item.featured_image.alt | default: item.title | escape }}" loading="lazy" width="700" height="880" />
    {% else %}
    <div class="product-placeholder" aria-hidden="true">
      LQ.
    </div>
    {% endif %}{% if item.images.size > 1 %}
    <img class="product-secondary-image" src="{{ item.images[1] | image_url: width: 700 | escape }}" alt="{{ item.title | escape }}" width="700" height="880" loading="lazy" />
    {% endif %}{% if item.available %}
{% if item.compare_at_price > item.price %}
    <span class="product-tag">
      SALE
    </span>
    {% endif %}
{% else %}
    <span class="product-tag sold-out">
      ESGOTADO
    </span>
    {% endif %}
    <span class="product-image-arrow" aria-hidden="true">
      ↗
    </span>
  </a>
  <div class="product-info">
    <div class="product-info-top">
      <span class="product-type">
        LIQUIDIFY ESSENTIALS
      </span>
      <span class="product-options-note">
        {% if item.variants.size == 1 %}
1 opção
{% else %}
{{ item.variants.size | append: ' opções' }}
{% endif %}
      </span>
    </div>
    <h3>
      <a href="{{ item.url | escape }}">
        {{ item.title | escape }}
      </a>
    </h3>
    <div class="product-prices">
      <strong>
        {% if item.price_min != item.price_max %}
        <small>
          A partir de
        </small>
        {% endif %}{{ item.price | money | escape }}
      </strong>
      {% if item.compare_at_price > item.price %}
      <s>
        {{ item.compare_at_price | money | escape }}
      </s>
      {% endif %}
    </div>
    {% if item.available %}
{% if item.variants.size == 1 and item.requires_selling_plan != true %}
    <form action="{{ routes.cart_add_url | escape }}" method="post" data-quick-add>
      <input type="hidden" name="id" value="{{ item.variants.first.id | escape }}" />
      <input type="hidden" name="quantity" value="1" />
      <button class="card-buy-button" type="submit">
        {% render 'theme-icon', name: 'bag' %}
        <span>
          Adicionar à sacola
        </span>
        <span aria-hidden="true">
          +
        </span>
      </button>
      <p class="quick-add-message" role="status">
      </p>
    </form>
    {% else %}
    <a class="card-buy-button" href="{{ item.url | escape }}">
      {% render 'theme-icon', name: 'bag' %}
      <span>
        Escolher opções
      </span>
      <span aria-hidden="true">
        +
      </span>
    </a>
    {% endif %}
{% else %}
    <span class="card-buy-button unavailable">
      Indisponível
    </span>
    {% endif %}
  </div>
</article>

{% stylesheet %}
.product-card {
  min-width: 0;
}

.product-image-link {
  display: block;
  position: relative;
  aspect-ratio: 4/5;
  background: #f1f1f1;
  border-radius: 9px;
  overflow: hidden;
}

.product-image-link img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition:
    opacity 0.35s,
    transform 0.5s;
}

.product-primary-image {
  position: relative;
}

.product-secondary-image {
  position: absolute;
  inset: 0;
  opacity: 0;
}

.product-image-link:hover .product-secondary-image {
  opacity: 1;
}

.product-image-link:hover .product-primary-image {
  transform: scale(1.025);
}

.product-image-arrow {
  position: absolute;
  right: 13px;
  bottom: 13px;
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 50%;
  font-size: 19px;
}

.product-tag {
  position: absolute;
  left: 13px;
  top: 13px;
  z-index: 1;
  background: #171717;
  color: white;
  font-size: 8px;
  letter-spacing: 1px;
  padding: 5px 9px;
  border-radius: 3px;
}

.product-tag.sold-out {
  background: #f4f4f4;
  color: #555;
}

.product-info {
  padding: 15px 2px 0;
}

.product-info-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 5px;
}

.product-type {
  font-size: 8px;
  letter-spacing: 1px;
  color: #777;
}

.product-options-note {
  font-size: 8px;
  color: #777;
}

.product-info h3 {
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
  margin: 8px 0 9px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-prices {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 13px;
  flex-wrap: wrap;
}

.product-prices strong {
  font-weight: 600;
}

.product-prices small {
  font-weight: 400;
  font-size: 10px;
}

.product-prices s {
  font-size: 11px;
}

.card-buy-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 41px;
  background: transparent;
  border: 1px solid #dcdcdc;
  border-radius: 5px;
  font-size: 10px;
  gap: 9px;
  margin-top: 15px;
  padding: 8px 12px;
}

.card-buy-button svg {
  width: 15px;
  height: 15px;
}

.card-buy-button:hover {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

.card-buy-button.unavailable {
  opacity: 0.4;
  cursor: not-allowed;
}

@media (max-width: 680px) {
  .product-image-link {
    aspect-ratio: 1/1.15;
  }
  .card-buy-button {
    font-size: 9px;
    padding: 6px 8px;
  }
}

{% endstylesheet %}