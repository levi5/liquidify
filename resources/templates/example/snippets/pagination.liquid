{% if pager.pages > 1 %}
<div class="pagination-footer">
  <p class="pagination-caption">
    {{ pager.current_page | prepend: "Página " | append: " de " | append: pager.pages }}
  </p>
  <nav class="pagination" aria-label="Paginação">
    {% if pager.previous %}
    <a class="pagination-direction" href="{{ pager.previous.url | escape }}" aria-label="Página anterior" rel="prev">
      ←
      <span>
        Anterior
      </span>
    </a>
    {% endif %}{% for part in pager.parts %}{% assign page_number = part.title | plus: 0 %}
{% if part.is_link %}
    <a href="{{ part.url | escape }}" aria-label="Ir para a página {{ part.title | escape }}">
      {{ part.title | escape }}
    </a>
    {% else %}
{% if page_number == pager.current_page %}
    <span aria-current="page" aria-label="Página {{ part.title | escape }}, atual">
      {{ part.title | escape }}
    </span>
    {% else %}
    <span class="pagination-ellipsis" aria-hidden="true">
      {{ part.title | escape }}
    </span>
    {% endif %}
{% endif %}{% endfor %}{% if pager.next %}
    <a class="pagination-direction" href="{{ pager.next.url | escape }}" aria-label="Próxima página" rel="next">
      <span>
        Próxima
      </span>
      →
    </a>
    {% endif %}
  </nav>
</div>
{% endif %}

{% stylesheet %}
.pagination-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 36px;
  padding-top: 26px;
  border-top: 1px solid var(--line);
}

.pagination-caption {
  margin: 0;
  font-size: 12px;
  color: var(--muted);
}

.pagination-footer .pagination {
  margin: 0;
  flex-wrap: wrap;
  gap: 6px;
}

.pagination-footer .pagination > a,
.pagination-footer .pagination > span {
  min-width: 40px;
  height: 40px;
  border-radius: 4px;
  font-size: 12px;
}

.pagination-footer .pagination > a:hover {
  background: var(--ink);
  color: var(--paper);
}

.pagination-footer .pagination > .pagination-ellipsis {
  border: 0;
  min-width: 20px;
}

.pagination-footer .pagination > .pagination-direction {
  padding: 0 12px;
  gap: 7px;
}

.pagination-footer .pagination > [aria-disabled='true'] {
  color: var(--muted);
  opacity: 0.5;
}

@media (max-width: 680px) {
  .pagination-footer {
    flex-direction: column;
    gap: 15px;
    margin-top: 28px;
  }
  .pagination-footer .pagination > .pagination-direction {
    padding: 0;
    min-width: 40px;
  }
  .pagination-direction > span {
    display: none;
  }
}

{% endstylesheet %}