{% assign filters_some = false %}
{% for filter in filters %}
  {% if filter.active_values.size > 0 or filter.min_value.value != null or filter.max_value.value != null %}
    {% assign filters_some = true %}
    {% break %}
  {% endif %}
{% endfor %}

{% assign hasActiveFilters = filters_some %}
{% if hasActiveFilters %}
<div class="active-filters" aria-label="Filtros ativos">
  {% for filter in filters %}{% for value in filter.active_values %}
  <a class="active-filter" href="{{ value.url_to_remove | escape }}" aria-label="{{ "Remover filtro " | append: filter.label | append: ": " | append: value.label | escape }}">
    <span>
      {{ filter.label | append: ": " | append: value.label | escape }}
    </span>
    <span aria-hidden="true">
      ×
    </span>
  </a>
  {% endfor %}{% if filter.type == "price_range" %}
{% if filter.min_value.value != null or filter.max_value.value != null %}
  <a class="active-filter" href="{{ filter.url_to_remove | escape }}" aria-label="Remover filtro de preço">
    <span>
      Preço:{% if filter.min_value.value != null %}
{{ filter.min_value.value | escape }}
{% else %}
{{ 0 | escape }}
{% endif %} {% if filter.max_value.value != null %}
{{ "— " | append: filter.max_value.value | escape }}
{% else %}
{% if filter.range_max != null %}
{{ "— " | append: filter.range_max | escape }}
{% else %}

{% endif %}
{% endif %}
    </span>
    <span aria-hidden="true">
      ×
    </span>
  </a>
  {% endif %}
{% endif %}{% endfor %}
  <a class="text-link" href="{{ window.location.pathname + 'sort_by=' | plus: collection.sort_by or collection.default_sort_by | escape }}">
    Limpar todos
  </a>
</div>
{% endif %}

{% stylesheet %}
.active-filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin: 0 0 24px;
}

.active-filters:empty {
  display: none;
}

.active-filter {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 9px 12px;
  border: 1px solid var(--line);
  border-radius: 4px;
  font-size: 11px;
  line-height: 1.5;
}

.active-filter:hover {
  border-color: var(--ink);
}

.active-filter > span:last-child {
  font-size: 17px;
  line-height: 1;
}

.active-filters .text-link {
  font-size: 11px;
  margin-left: 5px;
}

{% endstylesheet %}