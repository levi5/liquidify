<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.primary_color | default: '#171717' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'liquidify-icon.svg' | asset_url }}">
    <meta property="og:site_name" content="{{ settings.brand_name | default: shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
    {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
    {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
    <title>
      {% if request.page_type == 'index' %}
        {{ settings.brand_name | default: shop.name | escape }} — {{ 'general.home_title' | t }}
      {% else %}
        {{ page_title | escape }}{% if current_page != 1 %} — {{ current_page }}{% endif %} — {{ settings.brand_name | default: shop.name | escape }}
      {% endif %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    {{ 'global.css' | asset_url | stylesheet_tag }}
    {% render 'css-variables' %}

    <script>
      window.LiquidifyTheme = {
        currency: {{ cart.currency.iso_code | default: shop.currency | json }},
        locale: {{ request.locale.iso_code | json }},
        root: {{ routes.root_url | json }},
        account: {{ routes.account_url | json }},
        i18n: {
          cart_load_error: {{ 'cart.load_error' | t | json }},
          cart_add_success: {{ 'cart.add_success' | t | json }},
          cart_add_error: {{ 'cart.add_error' | t | json }},
          cart_adding: {{ 'cart.adding' | t | json }},
          cart_updating: {{ 'cart.updating' | t | json }},
          cart_try_again: {{ 'cart.try_again' | t | json }},
          cart_open_page: {{ 'cart.open_page' | t | json }},
          cart_empty_heading: {{ 'cart.empty_heading' | t | json }},
          cart_empty_text: {{ 'cart.empty_text' | t | json }},
          cart_subtotal: {{ 'cart.subtotal' | t | json }},
          cart_quantity: {{ 'cart.quantity' | t | json }},
          cart_update_error: {{ 'cart.update_error' | t | json }},
          cart_empty_title: {{ 'cart.empty_title' | t | json }},
          cart_search_button: {{ 'cart.search_button' | t | json }},
          header_search_products: {{ 'header.search_products' | t | json }},
          header_account_login: {{ 'header.account_login' | t | json }},
          header_open_menu: {{ 'header.open_menu' | t | json }},
          header_main_menu: {{ 'header.main_menu' | t | json }},
          header_new: {{ 'header.new' | t | json }},
          header_women: {{ 'header.women' | t | json }},
          header_men: {{ 'header.men' | t | json }},
          header_accessories: {{ 'header.accessories' | t | json }},
          header_view_women: {{ 'header.view_women' | t | json }},
          header_view_men: {{ 'header.view_men' | t | json }},
          header_view_accessories: {{ 'header.view_accessories' | t | json }},
          header_view_all_in: {{ 'header.view_all_in' | t | json }},
          header_women_tops: {{ 'header.women_tops' | t | json }},
          header_women_jackets: {{ 'header.women_jackets' | t | json }},
          header_women_skirts: {{ 'header.women_skirts' | t | json }},
          header_men_shirts: {{ 'header.men_shirts' | t | json }},
          header_men_jackets: {{ 'header.men_jackets' | t | json }},
          header_men_tailoring: {{ 'header.men_tailoring' | t | json }},
          header_bags: {{ 'header.bags' | t | json }},
          header_shoes: {{ 'header.shoes' | t | json }},
          cart_shipping_taxes: {{ 'cart.shipping_taxes' | t | json }},
          cart_secure_payment: {{ 'cart.secure_payment' | t | json }},
          cart_checkout: {{ 'cart.checkout' | t | json }},
          cart_view_bag: {{ 'general.bag' | t | json }},
          general_remove: {{ 'general.remove' | t | json }},
          general_previous: {{ 'general.previous' | t | json }},
          general_next: {{ 'general.next' | t | json }},
          cart_decrease: {{ 'cart.decrease' | t | json }},
          cart_increase: {{ 'cart.increase' | t | json }},
          products_combination_unavailable: {{ 'products.product.combination_unavailable' | t | json }},
          products_unavailable_suffix: {{ 'products.product.unavailable_suffix' | t | json }},
          products_unavailable: {{ 'products.product.unavailable' | t | json }},
          products_soldout: {{ 'products.product.soldout' | t | json }},
          products_add_to_bag: {{ 'products.product.add_to_bag' | t | json }},
          products_adding: {{ 'products.product.adding' | t | json }},
          products_added_to_bag: {{ 'products.product.added_to_bag' | t | json }},
          products_add_error: {{ 'products.product.add_error' | t | json }},
          products_selling_plan: {{ 'products.product.selling_plan' | t | json }},
          products_quantity: {{ 'products.product.quantity' | t | json }},
          products_decrease_quantity: {{ 'products.product.decrease_quantity' | t | json }},
          products_increase_quantity: {{ 'products.product.increase_quantity' | t | json }},
          cart_bag_title: {{ 'cart.bag_title' | t | json }},
          cart_search_title: {{ 'cart.search_title' | t | json }},
          cart_menu_title: {{ 'cart.menu_title' | t | json }},
          cart_dialog_eyebrow: {{ 'cart.dialog_eyebrow' | t | json }},
          general_close: {{ 'general.close' | t | json }},
          cart_search_label: {{ 'cart.search_label' | t | json }},
          cart_search_placeholder: {{ 'cart.search_placeholder' | t | json }},
          general_search: {{ 'general.search' | t | json }},
          cart_start_here: {{ 'cart.start_here' | t | json }},
          cart_explore_all: {{ 'cart.explore_all' | t | json }},
          cart_explore_store: {{ 'cart.explore_store' | t | json }},
          cart_mobile_menu: {{ 'cart.mobile_menu' | t | json }},
          cart_view_all_in: {{ 'cart.view_all_in' | t | json }},
          cart_my_account: {{ 'cart.my_account' | t | json }},
          filters_title: {{ 'filters.title' | t | json }},
          filters_refine: {{ 'filters.refine' | t | json }},
          filters_close: {{ 'filters.close' | t | json }},
          filters_filter_products: {{ 'filters.filter_products' | t | json }},
          filters_from: {{ 'filters.from' | t | json }},
          filters_to: {{ 'filters.to' | t | json }},
          filters_empty: {{ 'filters.empty' | t | json }},
          filters_apply: {{ 'filters.apply' | t | json }},
          filters_clear: {{ 'filters.clear' | t | json }},
          filters_clear_all: {{ 'filters.clear_all' | t | json }},
          filters_active: {{ 'filters.active' | t | json }},
          filters_remove: {{ 'filters.remove' | t | json }},
          filters_remove_price: {{ 'filters.remove_price' | t | json }},
          theme_play_announcements: {{ 'theme.play_announcements' | t | json }},
          theme_pause_announcements: {{ 'theme.pause_announcements' | t | json }},
          theme_adding: {{ 'theme.adding' | t | json }},
          theme_added_to_bag: {{ 'theme.added_to_bag' | t | json }},
          theme_add_error: {{ 'theme.add_error' | t | json }}
        }
      };
    </script>
    <script src="{{ 'react-runtime.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% render 'script-global' %}
  </body>
</html>
