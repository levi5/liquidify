{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./lib",
    "outDir": "./dist",
    "declaration": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "jsx": "preserve"
  },
  "include": ["lib/**/*"],
  "exclude": ["lib/docs", "lib/README.md"]
}