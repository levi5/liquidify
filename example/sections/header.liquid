<div class="header-shell">
  <style>
    .nav-dropdown{position:relative}.nav-dropdown>summary{display:flex;align-items:center;gap:7px;min-height:44px;cursor:pointer;list-style:none}.nav-dropdown>summary::-webkit-details-marker{display:none}.nav-chevron{width:6px;height:6px;border-right:1px solid currentColor;border-bottom:1px solid currentColor;transform:rotate(45deg);margin:0 2px 4px;transition:transform .15s}.nav-dropdown[open]>summary .nav-chevron{transform:rotate(225deg);margin-bottom:0}.nav-submenu{position:absolute;top:100%;left:-20px;min-width:230px;padding:12px;background:var(--paper);border:1px solid var(--line);border-radius:8px;box-shadow:0 12px 32px #0000000f;z-index:40}.desktop-nav .nav-submenu a{display:block;padding:12px;border-radius:4px;font-size:12px;line-height:1.5}.desktop-nav .nav-submenu a:hover,.desktop-nav .nav-submenu a:focus-visible{background:var(--surface,#f5f5f3)}.desktop-nav .nav-submenu a:hover::after{content:none}.nav-submenu .nav-overview{font-weight:600;border-bottom:1px solid var(--line);margin-bottom:5px}.nav-submenu .nav-grandchild{padding-left:25px;font-size:11px;color:var(--muted)}.mobile-menu-group{border-bottom:1px solid var(--line)}.mobile-menu-group>summary{display:flex;align-items:center;justify-content:space-between;padding:20px 0;font-size:22px;letter-spacing:-.5px;list-style:none;cursor:pointer}.mobile-menu-group>summary::-webkit-details-marker{display:none}.mobile-menu-group[open]>summary .nav-chevron{transform:rotate(225deg)}.mobile-menu-group .mobile-sub-link{padding:12px 14px;font-size:15px;letter-spacing:0}.mobile-menu-group .mobile-grandchild{padding-left:28px;font-size:13px}.mobile-submenu{padding-bottom:12px}
  </style>
  <div class="announcement" data-announcement>
    <button class="announcement-arrow" type="button" data-announcement-prev aria-label="Aviso anterior">
      ‹
    </button>
    <div class="announcement-messages" aria-live="off">
      <p data-announcement-message>
        {{ section.settings.announcement | escape }}
      </p>
      <p data-announcement-message hidden>
        {{ section.settings.announcement_2 | escape }}
      </p>
      <p data-announcement-message hidden>
        {{ section.settings.announcement_3 | escape }}
      </p>
    </div>
    <button class="announcement-arrow" type="button" data-announcement-next aria-label="Próximo aviso">
      ›
    </button>
    <button class="announcement-pause" type="button" data-announcement-pause aria-label="Pausar avisos" aria-pressed="false">
      Ⅱ
    </button>
  </div>
  <header class="site-header container">
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="Liquidify — página inicial">
      {{ settings.brand_name | default: "Liquidify" | escape }}
    </a>
    <nav class="desktop-nav" aria-label="Menu principal">
      {% if section.settings.menu.links.size > 0 %}
{% for link in section.settings.menu.links %}{% if link.links.size > 0 %}
      <details class="nav-dropdown" data-menu-item>
        <summary>
          {{ link.title | escape }}
          <span class="nav-chevron" aria-hidden="true">
          </span>
        </summary>
        <div class="nav-submenu">
          <a class="nav-overview" data-menu-overview href="{{ link.url }}">
            Ver tudo em{{ link.title | escape }}↗
          </a>
          {% for child in link.links %}
          <div>
            <a data-menu-child href="{{ child.url }}">
              {{ child.title | escape }}
            </a>
            {% for grandchild in child.links %}
            <a class="nav-grandchild" href="{{ grandchild.url }}">
              {{ grandchild.title | escape }}
            </a>
            {% endfor %}
          </div>
          {% endfor %}
        </div>
      </details>
      {% else %}
      <a data-menu-item href="{{ link.url }}">
        {{ link.title | escape }}
      </a>
      {% endif %}{% endfor %}
{% else %}
      <a data-menu-item href="{{ routes.root_url | escape }}collections/all?sort_by=created-descending">
        Novidades
      </a>
      <details class="nav-dropdown" data-menu-item>
        <summary>
          Feminino
          <span class="nav-chevron" aria-hidden="true">
          </span>
        </summary>
        <div class="nav-submenu">
          <a class="nav-overview" data-menu-overview href="{{ section.settings.women_link | default: '/collections/all/feminino' | escape }}">
            Ver coleção feminina ↗
          </a>
          <a data-menu-child href="{{ routes.search_url | escape }}?type=product&q=tag%3AFeminino%20AND%20%28top%20OR%20shirt%29">
            Blusas e camisetas
          </a>
          <a data-menu-child href="{{ routes.search_url | escape }}?type=product&q=tag%3AFeminino%20AND%20jacket">
            Jaquetas
          </a>
          <a data-menu-child href="{{ routes.search_url | escape }}?type=product&q=tag%3AFeminino%20AND%20skirt">
            Saias e conjuntos
          </a>
        </div>
      </details>
      <details class="nav-dropdown" data-menu-item>
        <summary>
          Masculino
          <span class="nav-chevron" aria-hidden="true">
          </span>
        </summary>
        <div class="nav-submenu">
          <a class="nav-overview" data-menu-overview href="{{ section.settings.men_link | default: '/collections/all/masculino' | escape }}">
            Ver coleção masculina ↗
          </a>
          <a data-menu-child href="{{ routes.search_url | escape }}?type=product&q=tag%3AMasculino%20AND%20shirt">
            Camisas
          </a>
          <a data-menu-child href="{{ routes.search_url | escape }}?type=product&q=tag%3AMasculino%20AND%20jacket">
            Jaquetas
          </a>
          <a data-menu-child href="{{ routes.search_url | escape }}?type=product&q=tag%3AMasculino%20AND%20tuxedo">
            Alfaiataria
          </a>
        </div>
      </details>
      <details class="nav-dropdown" data-menu-item>
        <summary>
          Acessórios
          <span class="nav-chevron" aria-hidden="true">
          </span>
        </summary>
        <div class="nav-submenu">
          <a class="nav-overview" data-menu-overview href="{{ section.settings.accessories_link | default: '/search?type=product&q=bag%20OR%20shoes' | escape }}">
            Ver todos os acessórios ↗
          </a>
          <a data-menu-child href="{{ routes.search_url | escape }}?type=product&q=bag">
            Bolsas
          </a>
          <a data-menu-child href="{{ routes.search_url | escape }}?type=product&q=shoes%20OR%20%22high%20tops%22">
            Calçados
          </a>
        </div>
      </details>
      {% endif %}
    </nav>
    <div class="header-actions">
      <a href="{{ routes.search_url }}" class="icon-button" data-open-panel="search" aria-label="Buscar produtos">
        {% render 'theme-icon', name: 'search' %}
      </a>
      <a href="{{ routes.account_url }}" class="icon-button account-link" aria-label="Entrar na minha conta">
        {% render 'theme-icon', name: 'user' %}
      </a>
      <a href="{{ routes.cart_url }}" class="icon-button bag-button" data-open-panel="cart" aria-label="Abrir sacola">
        <span class="bag-icon" style="position: relative; display: inline-flex; flex-shrink: 0; ">
          {% render 'theme-icon', name: 'bag' %}
          <span class="cart-count" data-cart-count aria-live="polite" aria-atomic="true" style="position: absolute; top: -8px; right: -9px; min-width: 18px; height: 18px; padding: 0 4px; background: var(--ink); color: var(--paper); border: 2px solid var(--paper); font-size: 9px; font-weight: 600; pointer-events: none; ">
            {{ cart.item_count }}
          </span>
        </span>
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="icon-button mobile-menu-trigger" data-open-panel="menu" aria-label="Abrir menu">
        {% render 'theme-icon', name: 'menu' %}
      </a>
    </div>
    <div class="island-bridge" data-liquid-store="{{ cart | json | escape }}" data-liquidify-menu="{{ section.settings.menu.links | json | escape }}">
      <react-island data-hydrate="eager" style="display: flex;" component="Storefront">
        </react-island>
      </div>
    </header>
  </div>

{%- unless script_storefront_loaded -%}
  <script src="{{ 'storefront.js' | asset_url }}" defer></script>
  {%- assign script_storefront_loaded = true -%}
{%- endunless -%}

{% schema %}
{
  "name": "Cabeçalho e avisos",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Aviso 1",
      "default": "SEU ESTILO, SUAS REGRAS. CONHEÇA A NOVA COLEÇÃO."
    },
    {
      "type": "text",
      "id": "announcement_2",
      "label": "Aviso 2",
      "default": "FEMININO, MASCULINO E ACESSÓRIOS EM UM SÓ LUGAR."
    },
    {
      "type": "text",
      "id": "announcement_3",
      "label": "Aviso 3",
      "default": "ESCOLHA SEUS FAVORITOS. COMPRE COM SEGURANÇA."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu personalizado (opcional)"
    },
    {
      "type": "url",
      "id": "women_link",
      "label": "Link Feminino"
    },
    {
      "type": "url",
      "id": "men_link",
      "label": "Link Masculino"
    },
    {
      "type": "url",
      "id": "accessories_link",
      "label": "Link Acessórios"
    }
  ]
}
{% endschema %}