{% assign related_collection = product.collections[0] | default: collections.all %}

<section class="related-products container section-space" id="RelatedProducts-{{ section.id | escape }}">
  <style>
    .related-products:not(:has(.product-card)){display:none}.related-products .product-grid{grid-template-columns:repeat(4,minmax(0,1fr))}@media(max-width:900px){.related-products .product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  </style>
  <div class="section-heading">
    <div>
      <p class="eyebrow">
        CONTINUE DESCOBRINDO
      </p>
      <h2>
        {{ section.settings.heading | escape }}
      </h2>
    </div>
    <a class="text-link" href="{{ routes.all_products_collection_url }}">
      Ver coleção ↗
    </a>
  </div>
  <div class="product-grid" data-related-grid data-recommendations-state="{% if recommendations.performed and recommendations.products_count >
    0 %}loaded{% else %}fallback{% endif %}">{% if recommendations.performed and recommendations.products_count > 0 %}
{% for item in recommendations.products %}{% if item.id != product.id %}
{% render 'product-card', item: item %}
{% endif %}{% endfor %}
{% else %}
{% for item in related_collection.products limit: 4 %}{% if item.id != product.id and item.available %}
{% render 'product-card', item: item %}
{% endif %}{% endfor %}
{% endif %}
  </div>
  <react-island data-hydrate="eager" style="display: flex;" component="RecommendationLoader">
    <script type="application/json" data-react-props>
      {"productId": {{ product.id | json }}, "sectionId": {{ section.id | json }}}
    </script>
    </react-island>
  </section>

{%- unless script_recommendation_loader_loaded -%}
  <script src="{{ 'recommendation-loader.js' | asset_url }}" defer></script>
  {%- assign script_recommendation_loader_loaded = true -%}
{%- endunless -%}

{% schema %}
{
  "name": "Produtos relacionados",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Complete o look."
    }
  ],
  "presets": [
    {
      "name": "Produtos relacionados"
    }
  ]
}
{% endschema %}