<section class="product-detail container section-space">
  <nav class="breadcrumbs" aria-label="Navegação estrutural">
    <a href="{{ routes.root_url }}">
      Início
    </a>
    <span>
      /
    </span>
    <a href="{{ routes.all_products_collection_url }}">
      Loja
    </a>
    <span>
      /
    </span>
    <span>
      {{ product.title | escape }}
    </span>
  </nav>
  <div class="product-detail-grid">
    <div class="product-gallery">
      {% if product.featured_image %}
      <a class="main-product-image" href="{{ product.featured_image | image_url: width: 2000 | escape }}" target="_blank" rel="noopener">
        <img id="ProductMainImage" src="{{ product.featured_image | image_url: width: 1200 | escape }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1000" height="1200" fetchpriority="high" />
      </a>
      {% else %}
      <div class="product-placeholder">
        ✳
      </div>
      {% endif %}{% if product.images.size > 1 %}
      <div class="product-thumbnails">
        {% for photo in product.images %}
        <a href="{{ photo | image_url: width: 2000 | escape }}" data-product-thumbnail="{{ photo | image_url: width: 1200 | escape }}">
          <img src="{{ photo | image_url: width: 200 | escape }}" alt="{{ photo.alt | default: product.title | escape }}" width="120" height="144" loading="lazy" />
        </a>
        {% endfor %}
      </div>
      {% endif %}{% for media in product.media %}{% unless media.media_type == "image" %}
      <div class="product-media">
        {{ media | media_tag: image_size: "1000x", controls: true }}
      </div>
      {% endunless %}{% endfor %}
    </div>
    <div class="product-detail-copy">
      <p class="eyebrow">
        {{ product.vendor | escape }}
      </p>
      <h1>
        {{ product.title | escape }}
      </h1>
      <p class="product-intro">
        Estilo para acompanhar o seu ritmo. Escolha sua combinação.
      </p>
      <div class="island-bridge" data-liquid-store="{{ product | json | escape }}" data-liquid-selected="{{ product.selected_or_first_available_variant.id | json | escape }}">
        <react-island data-hydrate="eager" style="display: flex;" component="ProductPurchase">
          <form action="{{ routes.cart_add_url }}" method="post" class="purchase-form">
            <p class="detail-price">
              {{ product.price | money }}
            </p>
            <label for="FallbackVariant">
              Escolha uma opção
            </label>
            <select id="FallbackVariant" name="id">
              {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %}>
                {{ variant.title | escape }}—{{ variant.price | money }}
              </option>
              {% endfor %}
            </select>
            <label for="FallbackQuantity">
              Quantidade
            </label>
            <input id="FallbackQuantity" name="quantity" type="number" min="1" value="1" />
            <fieldset {% if product.requires_selling_plan == true %}disabled{% endif %} style="border: 0; margin: 0; padding: 0; ">
              <button class="button button-dark product-add-button" style="width: 100%; max-width: 320px; " type="submit" {% unless product.available %}disabled{% endunless %}>
                Adicionar à sacola ↗
              </button>
            </fieldset>
          </form>
          </react-island>
          {% if product.requires_selling_plan %}
          <noscript>
            Este produto exige um plano de assinatura. Entre em contato com a loja para escolher seu
                plano.
          </noscript>
          {% endif %}
        </div>
        <div class="purchase-note">
          <span aria-hidden="true">
            ↗
          </span>
          <span>
            Frete calculado no checkout.
            <br />
            Seus dados protegidos em cada etapa.
          </span>
        </div>
        <details class="product-accordion" open>
          <summary>
            Sobre a peça
            <span>
              +
            </span>
          </summary>
          <div class="rich-text">
            {{ product.description }}
          </div>
        </details>
        <details class="product-accordion">
          <summary>
            Entrega e devolução
            <span>
              +
            </span>
          </summary>
          <div class="rich-text">
            <p>
              Informe seu endereço no checkout para consultar os prazos e as opções de entrega disponíveis.
            </p>
            {% if shop.shipping_policy != blank %}
            <a href="{{ shop.shipping_policy.url | escape }}">
              Política de envio ↗
            </a>
            {% endif %}{% if shop.refund_policy != blank %}
            <a href="{{ shop.refund_policy.url | escape }}">
              Política de devolução ↗
            </a>
            {% endif %}
          </div>
        </details>
      </div>
    </div>
    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  </section>

{%- unless script_product_purchase_loaded -%}
  <script src="{{ 'product-purchase.js' | asset_url }}" defer></script>
  {%- assign script_product_purchase_loaded = true -%}
{%- endunless -%}

{% schema %}
{
  "name": "Detalhes do produto",
  "settings": []
}
{% endschema %}