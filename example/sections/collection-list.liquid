<section class="container section-space">
  <div class="page-heading">
    <p class="eyebrow">
      UM UNIVERSO DE POSSIBILIDADES
    </p>
    <h1>
      Nossas coleções.
    </h1>
  </div>
  {% paginate collections by 24 %}
  <div class="category-grid">
    {% for item in collections %}
    <a class="category-card" href="{{ item.url | escape }}">
      {% if item.image %}
      <img src="{{ item.image | image_url: width: 900 | escape }}" alt="{{ item.title | escape }}" width="900" height="1000" loading="lazy" />
      {% else %}
      <div class="product-placeholder">
        ✳
      </div>
      {% endif %}
      <span class="category-label">
        <strong>
          {{ item.title | escape }}
        </strong>
        <span class="circle-arrow">
          ↗
        </span>
      </span>
    </a>
    {% endfor %}
  </div>
  {% render 'pagination', pager: paginate %}
{% endpaginate %}
</section>

{% schema %}
{
  "name": "Lista de coleções",
  "settings": []
}
{% endschema %}