<section class="values-strip container" aria-label="Compre com tranquilidade">
  <div class="value-item">
    {% render 'theme-icon', name: 'truck' %}
    <div>
      <h3>
        Do seu jeito, até você
      </h3>
      <p>
        Consulte as opções de entrega no checkout
      </p>
    </div>
  </div>
  <div class="value-item">
    {% render 'theme-icon', name: 'shield' %}
    <div>
      <h3>
        Compra segura
      </h3>
      <p>
        Seus dados protegidos em cada etapa
      </p>
    </div>
  </div>
  <div class="value-item">
    {% render 'theme-icon', name: 'return' %}
    <div>
      <h3>
        Conte com a gente
      </h3>
      <p>
        Atendimento para ajudar na sua escolha
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefícios da loja",
  "settings": [],
  "presets": [
    {
      "name": "Benefícios da loja"
    }
  ]
}
{% endschema %}