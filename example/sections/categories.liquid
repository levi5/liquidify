<section class="categories container section-space" id="categorias">
  <div class="section-heading">
    <div>
      <p class="eyebrow">
        ENCONTRE O SEU PRÓXIMO LOOK
      </p>
      <h2>
        {{ section.settings.heading | default: "Qual é a sua vibe?" | escape }}
      </h2>
    </div>
    <span class="muted category-intro">
      Do básico ao inesperado.
      <br />
      Sempre do seu jeito.
    </span>
  </div>
  <div class="category-grid">
    {% for block in section.blocks %}
    <a class="category-card" href="{{ block.settings.link | default: routes.all_products_collection_url | escape }}" data-block-id="{{ block.id | escape }}">
      {% if block.settings.image %}
      <img src="{{ block.settings.image | image_url: width: 900 | escape }}" alt="{{ block.settings.title | escape }}" width="900" height="1000" loading="lazy" />
      {% else %}
      <img src="{{ block.settings.fallback | asset_url | escape }}" alt="{{ block.settings.title | escape }}" width="900" height="1000" loading="lazy" />
      {% endif %}
      <span class="category-label">
        <span>
          <small>
            {{ block.settings.subtitle | escape }}
          </small>
          <strong>
            {{ block.settings.title | escape }}
          </strong>
        </span>
        <span class="circle-arrow" aria-hidden="true">
          ↗
        </span>
      </span>
    </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Categorias de moda",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Qual é a sua vibe?"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Feminino"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo",
          "default": "NOVAS FORMAS DE SER VOCÊ"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Coleção ou página"
        },
        {
          "type": "select",
          "id": "fallback",
          "label": "Imagem de exemplo",
          "default": "liquidify-women.jpg",
          "options": [
            {
              "value": "liquidify-women.jpg",
              "label": "Feminino"
            },
            {
              "value": "liquidify-men.jpg",
              "label": "Masculino"
            },
            {
              "value": "liquidify-accessories.jpg",
              "label": "Acessórios"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorias de moda",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Feminino",
            "subtitle": "NOVAS FORMAS DE SER VOCÊ",
            "fallback": "liquidify-women.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Masculino",
            "subtitle": "ESSENCIAIS COM PERSONALIDADE",
            "fallback": "liquidify-men.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Acessórios",
            "subtitle": "OS DETALHES FAZEM O LOOK",
            "fallback": "liquidify-accessories.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.categories {
  padding-top: 12px;
}

.category-intro {
  font-size: 11px;
  line-height: 1.8;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.category-card {
  display: block;
  position: relative;
  aspect-ratio: 1/1.03;
  background: #eee;
  border-radius: 9px;
  overflow: hidden;
}

.category-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s;
}

.category-card:hover img {
  transform: scale(1.035);
}

.category-card::after {
  content: '';
  position: absolute;
  inset: 40% 0 0;
  background: linear-gradient(transparent, #0009);
}

.category-label {
  position: absolute;
  left: 25px;
  right: 25px;
  bottom: 25px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  color: white;
  z-index: 1;
  gap: 10px;
}

.category-label small {
  display: block;
  font-size: 8px;
  letter-spacing: 1px;
  margin-bottom: 8px;
}

.category-label strong {
  font-size: 29px;
  font-weight: 450;
  letter-spacing: -0.6px;
}

.circle-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 1px solid currentColor;
  border-radius: 50%;
  font-size: 22px;
  flex-shrink: 0;
}

@media (max-width: 900px) {
  .category-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 680px) {
  .category-grid {
    grid-template-columns: 1fr;
  }
  .category-label {
    left: 18px;
    right: 18px;
    bottom: 18px;
  }
  .category-label strong {
    font-size: 24px;
  }
}

{% endstylesheet %}