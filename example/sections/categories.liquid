<section class="categories container section-space" id="categorias">
  <div class="section-heading">
    <div>
      <p class="eyebrow">
        ENCONTRE O SEU PRÓXIMO LOOK
      </p>
      <h2>
        {{ section.settings.heading | escape }}
      </h2>
    </div>
    <span class="muted category-intro">
      Do básico ao inesperado.
      <br />
      Sempre do seu jeito.
    </span>
  </div>
  <div class="category-grid">
    {% for block in section.blocks %}
    <a class="category-card" href="{{ block.settings.link | default: routes.all_products_collection_url | escape }}" data-block-id="{{ block.id }}">
      {% if block.settings.image %}
      <img src="{{ block.settings.image | image_url: width: 900 | escape }}" alt="{{ block.settings.title | escape }}" width="900" height="1000" loading="lazy" />
      {% else %}
      <img src="{{ block.settings.fallback | asset_url | escape }}" alt="{{ block.settings.title | escape }}" width="900" height="1000" loading="lazy" />
      {% endif %}
      <span class="category-label">
        <span>
          <small>
            {{ block.settings.subtitle | escape }}
          </small>
          <strong>
            {{ block.settings.title | escape }}
          </strong>
        </span>
        <span class="circle-arrow" aria-hidden="true">
          ↗
        </span>
      </span>
    </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Categorias de moda",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Qual é a sua vibe?"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Feminino"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo",
          "default": "NOVAS FORMAS DE SER VOCÊ"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Coleção ou página"
        },
        {
          "type": "select",
          "id": "fallback",
          "label": "Imagem de exemplo",
          "default": "liquidify-women.jpg",
          "options": [
            {
              "value": "liquidify-women.jpg",
              "label": "Feminino"
            },
            {
              "value": "liquidify-men.jpg",
              "label": "Masculino"
            },
            {
              "value": "liquidify-accessories.jpg",
              "label": "Acessórios"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorias de moda",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Feminino",
            "subtitle": "NOVAS FORMAS DE SER VOCÊ",
            "fallback": "liquidify-women.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Masculino",
            "subtitle": "ESSENCIAIS COM PERSONALIDADE",
            "fallback": "liquidify-men.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Acessórios",
            "subtitle": "OS DETALHES FAZEM O LOOK",
            "fallback": "liquidify-accessories.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}