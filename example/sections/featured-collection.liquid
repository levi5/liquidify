{% assign featured = section.settings.collection | default: collections.all %}
<section class="featured section-space container" id="favoritos">
  <div class="section-heading">
    <div>
      <p class="eyebrow">
        THE EVERYDAY EDIT
      </p>
      <h2>
        {{ section.settings.heading | default: "No seu radar." | escape }}
      </h2>
      <p class="section-subtitle">
        A próxima peça favorita do seu guarda-roupa está aqui.
      </p>
    </div>
    <a class="text-link" href="{{ featured.url | default: routes.all_products_collection_url | escape }}">
      Ver tudo
      <span aria-hidden="true">
        ↗
      </span>
    </a>
  </div>
  {% if featured.products.size > 0 %}
  <div class="product-grid">
    {% for item in featured.products limit: 8 %}{% render 'product-card', item: item %}{% endfor %}
  </div>
  {% else %}
  <div class="empty-state">
    <h3>
      Novas peças estão chegando.
    </h3>
    <p>
      Acompanhe os próximos lançamentos da Liquidify.
    </p>
  </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Produtos em destaque",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "No seu radar."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção"
    }
  ],
  "presets": [
    {
      "name": "Produtos em destaque"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.featured {
  position: relative;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 36px 22px;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 25px;
  margin-bottom: 32px;
}

.section-heading h2 {
  font-size: 36px;
  letter-spacing: -1.5px;
  font-weight: 550;
  margin-top: 10px;
}

.section-subtitle {
  color: var(--muted);
  font-size: 12px;
  margin-top: 12px;
}

.empty-state {
  padding: 70px 20px;
  text-align: center;
}

.empty-state h3 {
  font-size: 20px;
  margin-bottom: 10px;
}

.empty-state p {
  color: var(--muted);
  font-size: 13px;
}

@media (max-width: 900px) {
  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 14px;
  }
  .section-heading {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 480px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
}

{% endstylesheet %}