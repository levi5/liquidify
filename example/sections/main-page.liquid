<section class="content-page container section-space">
  <p class="eyebrow">
    LIQUIDIFY / MEET THE BRAND
  </p>
  <h1>
    {{ page.title | escape }}
  </h1>
  <div class="rich-text page-content">
    {{ page.content | escape }}
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}

{% stylesheet %}
.content-page {
  min-height: 55vh;
}

.content-page > h1,
.content-page > .eyebrow {
  text-align: center;
}

.page-content {
  max-width: 800px;
  margin: 40px auto;
  font-size: 15px;
}

{% endstylesheet %}