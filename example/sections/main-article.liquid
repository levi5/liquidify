<article class="article-page container section-space">
  <div class="page-heading">
    <a class="eyebrow" href="{{ blog.url }}">
      {{ blog.title | escape }}
    </a>
    <h1>
      {{ article.title | escape }}
    </h1>
    <p class="muted">
      {{ article.published_at | date: "%d.%m.%Y" }}·{{ article.author | escape }}
    </p>
  </div>
  {% if article.image %}
  <img class="article-cover" src="{{ article.image | image_url: width: 1800 | escape }}" alt="{{ article.image.alt | default: article.title | escape }}" width="1500" height="850" />
  {% endif %}
  <div class="rich-text page-content">
    {{ article.content }}
  </div>
  <a class="text-link" href="{{ blog.url }}">
    ← Voltar para o journal
  </a>
</article>

{% schema %}
{
  "name": "Artigo",
  "settings": []
}
{% endschema %}