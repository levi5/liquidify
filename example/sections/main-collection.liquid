{% assign selected_sort = collection.sort_by | default: collection.default_sort_by %}
<section class="catalog container section-space">
  <nav class="breadcrumbs" aria-label="Breadcrumb navigation">
    <a href="{{ routes.root_url | escape }}">
      Home
    </a>
    <span>
      /
    </span>
    <span>
      {{ collection.title | escape }}
    </span>
  </nav>
  <div class="page-heading">
    <p class="eyebrow">
      CHOICES THAT TRANSFORM
    </p>
    <h1>
      {% if current_tags.size > 0 %}
{{ current_tags | join: ' + ' | escape }}
{% else %}
{{ collection.title | escape }}
{% endif %}
    </h1>
    {% if collection.description %}
    <div class="rich-text">
      {{ collection.description | escape }}
    </div>
    {% endif %}
  </div>
  <div class="catalog-layout">
    {% render 'collection-filters', collection_filters: collection.filters, section_id: section.id, heading: section.settings.filter_heading %}
    <div class="catalog-results">
      <div class="catalog-toolbar">
        <span class="catalog-meta">
          {{ collection.products_count | append: " products" }}
        </span>
        <div class="sort-control">
          <label for="SortBy">
            Sort
          </label>
          <select id="SortBy" name="sort_by" form="CollectionFilters-{{ section.id | escape }}" data-selected="{{ collection.sort_by | default: collection.default_sort_by | escape }}">
            {% for option in collection.sort_options %}{% if option.value == selected_sort %}
            <option value="{{ option.value | escape }}" selected>
              {{ option.name | escape }}
            </option>
            {% else %}
            <option value="{{ option.value | escape }}">
              {{ option.name | escape }}
            </option>
            {% endif %}{% endfor %}
          </select>
        </div>
      </div>
      {% render 'active-filters', filters: collection.filters %}{% paginate collection.products by section.settings.products_per_page %}
{% if collection.products.size > 0 %}
      <div class="product-grid">
        {% for item in collection.products %}{% render 'product-card', item: item %}{% endfor %}
      </div>
      {% else %}
      <div class="empty-state">
        <span class="empty-spark">
          ✳
        </span>
        <h2>
          No pieces here.
        </h2>
        <p>
          Try adjusting the filters or explore the full collection.
        </p>
        <a class="button button-dark" href="{{ routes.all_products_collection_url | escape }}">
          View all products ↗
        </a>
      </div>
      {% endif %}{% render 'pagination', pager: paginate %}
{% endpaginate %}
    </div>
  </div>
</section>

{%- unless script_filter_drawer_loaded -%}
  <script src="{{ 'filter-drawer.js' | asset_url }}" defer></script>
  {%- assign script_filter_drawer_loaded = true -%}
{%- endunless -%}

{% schema %}
{
  "name": "Catálogo",
  "settings": [
    {
      "type": "text",
      "id": "filter_heading",
      "label": "Título dos filtros",
      "default": "Filtros"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Produtos por página",
      "min": 6,
      "max": 36,
      "step": 6,
      "default": 12
    }
  ]
}
{% endschema %}

{% stylesheet %}
.catalog {
  padding-top: 20px;
}

.breadcrumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  font-size: 10px;
  color: var(--muted);
  margin-bottom: 35px;
}

.breadcrumbs span:last-child {
  color: var(--ink);
}

.page-heading {
  margin-bottom: 45px;
  max-width: 820px;
}

.page-heading h1 {
  font-size: clamp(36px, 5vw, 66px);
  letter-spacing: -2.8px;
  margin: 15px 0 22px;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 36px 22px;
}

.empty-state {
  padding: 70px 20px;
  text-align: center;
}

.empty-state h2 {
  font-size: 28px;
  margin-bottom: 12px;
}

.empty-state p {
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 24px;
}

.empty-spark {
  display: inline-block;
  font-size: 24px;
  margin-bottom: 15px;
}

@media (max-width: 900px) {
  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 12px;
  }
}

@media (max-width: 480px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
}

{% endstylesheet %}