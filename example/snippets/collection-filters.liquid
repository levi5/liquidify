<aside class="catalog-sidebar" aria-label="Filtros de produtos">
  <style>
    .catalog-layout{display:grid;grid-template-columns:280px minmax(0,1fr);gap:38px;align-items:start}.catalog-results{min-width:0}.catalog-results>.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.catalog-toolbar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px;padding:0 0 22px;margin-bottom:25px;border-bottom:1px solid var(--line)}.catalog-toolbar>.catalog-meta{margin:0}.catalog-toolbar .sort-control{width:auto}.catalog-sidebar{border:1px solid var(--line);border-radius:8px;padding:22px;min-width:0}.sidebar-toggle{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:17px;font-weight:600;min-height:28px}.sidebar-toggle>span{font-size:20px;font-weight:400}.sidebar-sections[open]>.sidebar-toggle>span{transform:rotate(45deg)}.sidebar-filter-group{border-top:1px solid var(--line);margin-top:20px;padding-top:5px}.sidebar-filter-group>summary{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:14px 0;font-size:12px;font-weight:600}.sidebar-filter-group[open]>summary>span{transform:rotate(45deg)}.sidebar-filter-values{display:flex;flex-direction:column;gap:11px;padding-bottom:8px;max-height:290px;overflow:auto}.sidebar-option{display:flex;align-items:flex-start;gap:10px;font-size:11px;line-height:1.5;cursor:pointer}.sidebar-option input{margin:2px 0 0;flex-shrink:0}.sidebar-option small{color:var(--muted);font-size:10px}.sidebar-price-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.sidebar-price-fields label{font-size:11px}.sidebar-price-fields input{width:100%;padding:10px 8px;border-radius:4px;margin-top:6px;font-size:12px}.sidebar-filter-actions{display:flex;flex-direction:column;gap:17px;align-items:flex-start;margin-top:24px}.sidebar-filter-actions .button{width:100%;justify-content:center;min-height:43px;padding:10px;font-size:11px}.sidebar-filter-actions .text-link{font-size:10px}.sidebar-empty{font-size:11px;color:var(--muted);margin-top:18px}@media(max-width:1100px){.catalog-layout{grid-template-columns:250px minmax(0,1fr);gap:25px}.catalog-sidebar{padding:18px}.catalog-results>.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:680px){.catalog-layout{grid-template-columns:minmax(0,1fr);gap:24px}.catalog-sidebar{padding:18px}.sidebar-toggle{font-size:15px}.sidebar-price-fields{max-width:320px}.sidebar-filter-actions .button{max-width:320px}.catalog-toolbar{gap:16px;margin-bottom:22px}.catalog-toolbar .sort-control{width:100%}.catalog-results>.product-grid{gap:25px 14px}}
  </style>
  <style>
    .mobile-filter-trigger{display:none}.collection-filter-dialog{position:fixed;inset:0;margin:0 auto 0 0;width:min(88vw,380px);max-width:100vw;height:100dvh;max-height:100dvh;border:0;padding:0;background:var(--paper);color:var(--ink);overflow-y:auto;overscroll-behavior:contain;box-shadow:12px 0 40px #00000012}.collection-filter-dialog:not([open]){display:none}.collection-filter-dialog::backdrop{background:#0008;backdrop-filter:blur(2px)}.collection-filter-dialog[open]{animation:filter-in .2s ease-out}.filter-drawer-body{padding:0 24px 28px}.filter-drawer-body .sidebar-toggle{display:none}.filter-drawer-body .sidebar-filter-group:first-child{border-top:0;margin-top:8px}.filter-drawer-body .sidebar-option{font-size:13px;min-height:32px;align-items:center}.filter-drawer-body .sidebar-option input{width:17px;height:17px;margin:0}.filter-drawer-body .sidebar-filter-group>summary{font-size:14px;min-height:48px}.filter-drawer-body .sidebar-filter-actions{position:sticky;bottom:-28px;background:var(--paper);padding:20px 0 max(22px,env(safe-area-inset-bottom));border-top:1px solid var(--line);align-items:center}.filter-drawer-body .sidebar-filter-actions .button{max-width:none;min-height:48px}.filter-drawer-body .sidebar-price-fields{max-width:none}@keyframes filter-in{from{transform:translateX(-100%)}to{transform:translateX(0)}}@media(max-width:680px){.catalog-sidebar[data-drawer-ready]{border:0;border-radius:0;padding:0}.catalog-sidebar[data-drawer-ready] .mobile-filter-trigger{display:inline-flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:46px}.catalog-sidebar[data-drawer-ready] [data-filter-source]{display:none}}@media(prefers-reduced-motion:reduce){.collection-filter-dialog[open]{animation:none}}
  </style>
  <react-island data-hydrate="eager" style="display: flex;" component="FilterDrawer">
    <script type="application/json" data-react-props>
      {"sectionId": {{ section_id | json }}}
    </script>
    </react-island>
    <div data-filter-source>
      <details class="sidebar-sections" open>
        <summary class="sidebar-toggle">
          {{ heading | escape }}
          <span aria-hidden="true">
            +
          </span>
        </summary>
        <form id="CollectionFilters-{{ section_id | escape }}" method="get" action="{{ request.path | escape }}">
          {% for filter in collection_filters %}
          <details class="sidebar-filter-group" open>
            <summary>
              {{ filter.label | escape }}
              <span aria-hidden="true">
                +
              </span>
            </summary>
            {% if filter.type == "price_range" %}
            <div class="sidebar-price-fields">
              <label>
                De
                <input type="number" name="{{ filter.min_value.param_name }}" min="0" step="0.01" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100.0 | escape }}{% endif %}" placeholder="0" />
              </label>
              <label>
                Até
                <input type="number" name="{{ filter.max_value.param_name }}" min="0" step="0.01" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100.0 | escape }}{% endif %}" placeholder="{{ filter.range_max | divided_by: 100.0 | escape }}" />
              </label>
            </div>
            {% else %}
            <div class="sidebar-filter-values">
              {% for value in filter.values %}
              <label class="sidebar-option">
                <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active == true %}checked{% endif %} />
                <span>
                  {{ value.label | escape }}
                  <small>
                    ({{ value.count }})
                  </small>
                </span>
              </label>
              {% endfor %}
            </div>
            {% endif %}
          </details>
          {% endfor %}{% if collection_filters.size == 0 %}
          <p class="sidebar-empty">
            Não há filtros disponíveis nesta coleção.
          </p>
          {% endif %}
          <div class="sidebar-filter-actions">
            <button class="button button-dark" type="submit">
              Aplicar filtros
            </button>
            <a class="text-link" href="{{ request.path | escape }}?sort_by={{ collection.sort_by | default: collection.default_sort_by | url_encode }}">
              Limpar filtros
            </a>
          </div>
        </form>
      </details>
    </div>
  </aside>

{%- unless script_filter_drawer_loaded -%}
  <script src="{{ 'filter-drawer.js' | asset_url }}" defer></script>
  {%- assign script_filter_drawer_loaded = true -%}
{%- endunless -%}