<article class="product-card">
  <a class="product-image-link" href="{{ item.url | escape }}" aria-label="{{ item.title | escape }}">
    {% if item.featured_image %}
    <img class="product-primary-image" src="{{ item.featured_image | image_url: width: 700 | escape }}" alt="{{ item.featured_image.alt | default: item.title | escape }}" loading="lazy" width="700" height="880" />
    {% else %}
    <div class="product-placeholder" aria-hidden="true">
      LQ.
    </div>
    {% endif %}{% if item.images.size > 1 %}
    <img class="product-secondary-image" src="{{ item.images[1] | image_url: width: 700 | escape }}" alt="{{ item.title | escape }}" width="700" height="880" loading="lazy" />
    {% endif %}{% if item.available %}
{% if item.compare_at_price > item.price %}
    <span class="product-tag">
      SALE
    </span>
    {% endif %}
{% else %}
    <span class="product-tag sold-out">
      ESGOTADO
    </span>
    {% endif %}
    <span class="product-image-arrow" aria-hidden="true">
      ↗
    </span>
  </a>
  <div class="product-info">
    <div class="product-info-top">
      <span class="product-type">
        LIQUIDIFY ESSENTIALS
      </span>
      <span class="product-options-note">
        {% if item.variants.size == 1 %}
1 opção
{% else %}
{{ item.variants.size | append: ' opções' }}
{% endif %}
      </span>
    </div>
    <h3>
      <a href="{{ item.url | escape }}">
        {{ item.title | escape }}
      </a>
    </h3>
    <div class="product-prices">
      <strong>
        {% if item.price_min != item.price_max %}
        <small>
          A partir de
        </small>
        {% endif %}{{ item.price | money | escape }}
      </strong>
      {% if item.compare_at_price > item.price %}
      <s>
        {{ item.compare_at_price | money | escape }}
      </s>
      {% endif %}
    </div>
    {% if item.available %}
{% if item.variants.size == 1 and item.requires_selling_plan != true %}
    <form action="{{ routes.cart_add_url | escape }}" method="post" data-quick-add>
      <input type="hidden" name="id" value="{{ item.variants.first.id | escape }}" />
      <input type="hidden" name="quantity" value="1" />
      <button class="card-buy-button" type="submit">
        {% render 'theme-icon', name: 'bag' %}
        <span>
          Adicionar à sacola
        </span>
        <span aria-hidden="true">
          +
        </span>
      </button>
      <p class="quick-add-message" role="status">
      </p>
    </form>
    {% else %}
    <a class="card-buy-button" href="{{ item.url | escape }}">
      {% render 'theme-icon', name: 'bag' %}
      <span>
        Escolher opções
      </span>
      <span aria-hidden="true">
        +
      </span>
    </a>
    {% endif %}
{% else %}
    <span class="card-buy-button unavailable">
      Indisponível
    </span>
    {% endif %}
  </div>
</article>