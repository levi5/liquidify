<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.primary_color | default: '#171717' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'liquidify-icon.svg' | asset_url }}">
    <meta property="og:site_name" content="{{ settings.brand_name | default: shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
    {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
    {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
    <title>
      {% if request.page_type == 'index' %}
        {{ settings.brand_name | default: shop.name | escape }} — Seu estilo. Sem limites.
      {% else %}
        {{ page_title | escape }}{% if current_page != 1 %} — {{ current_page }}{% endif %} — {{ settings.brand_name | default: shop.name | escape }}
      {% endif %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    {{ 'global.css' | asset_url | stylesheet_tag }}
    {% render 'css-variables' %}

    <script>
      window.LiquidifyTheme = {currency: {{ cart.currency.iso_code | default: shop.currency | json }}, locale: {{ request.locale.iso_code | json }}, root: {{ routes.root_url | json }}, account: {{ routes.account_url | json }}};
    </script>
    <script src="{{ 'react-runtime.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#MainContent">Pular para o conteúdo</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% render 'script-global' %}
  </body>
</html>
